{
  "name": "ax1-premium-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prerender-metadata.mjs",
    "build:cloudflare": "vite build && node scripts/prerender-metadata.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/features/capital-value/capitalValueProtection.test.js .test-dist/features/publicFlows.test.js",
    "predeploy:cloudflare": "npm run build",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name ax1-website"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^4.5.14",
    "wrangler": "^4.127.0"
  }
}
