{
  "name": "ax1-premium-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr-dist && node scripts/prerender-pages.mjs",
    "build:cloudflare": "npm run build",
    "preview": "vite preview",
    "generate:og": "node scripts/generate-og.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/features/capital-value/capitalValueProtection.test.js .test-dist/features/publicFlows.test.js",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run lint && npm test && npm run build && npm run verify:build && npm run test:e2e",
    "predeploy:cloudflare": "npm run build",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name ax1-website",
    "postdeploy:cloudflare": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
